# Ambiente: development | staging | production | test
ENVIRONMENT=development

# Postgres do Supabase: botão "Connect" → "Session pooler" (funciona em IPv4).
# Troque o prefixo "postgresql://" por "postgresql+psycopg://". Não use o "Transaction pooler" (porta 6543).
DATABASE_URL=postgresql+psycopg://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Supabase Auth
SUPABASE_URL=https://PROJETO.supabase.co
# Deixe vazio se o projeto usa chaves JWT assimétricas (padrão em projetos novos; validadas via SUPABASE_URL).
# Preencha apenas se o projeto ainda usa o "Legacy JWT secret" (Settings → JWT Keys).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Storage: local (dev) | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.storage
STORAGE_BUCKET=fiscalguard-private
# Necessária apenas com STORAGE_BACKEND=supabase. NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# CORS (JSON)
CORS_ORIGINS=["http://localhost:3000"]

# Compliance (JSON)
COMPLIANCE_REQUIRED_CHECKS=["cadastro_cnpj","cnd_federal","crf_fgts","cndt"]
COMPLIANCE_EXPIRY_WARNING_DAYS=15
