# Ambiente: development | staging | production | test
ENVIRONMENT=development

# Conexão direta ao Postgres do Supabase (Project Settings → Database → Connection string).
# Use o usuário "postgres" (ou um role dedicado com permissão de SET ROLE authenticated).
DATABASE_URL=postgresql+psycopg://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres

# Supabase Auth
SUPABASE_URL=https://PROJETO.supabase.co
# Projetos com chave JWT legada (HS256). Projetos com chaves assimétricas usam o JWKS via SUPABASE_URL.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Storage: local (dev) | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.storage
STORAGE_BUCKET=fiscalguard-private
# Necessária apenas com STORAGE_BACKEND=supabase. NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# CORS (JSON)
CORS_ORIGINS=["http://localhost:3000"]

# Compliance (JSON)
COMPLIANCE_REQUIRED_CHECKS=["cadastro_cnpj","cnd_federal","crf_fgts","cndt"]
COMPLIANCE_EXPIRY_WARNING_DAYS=15
